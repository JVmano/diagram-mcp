# diagram-mcp configuration
#
# Copy to .env and edit as needed. Every value has a working default, so the
# server runs correctly with no .env file at all.
#
# This server needs NO secrets and NO credentials, because it calls no external
# service. Nothing here is sensitive. The file exists so that if you fork the
# server and add an integration, the key has an obvious home and stays out of
# source control (.env is gitignored, .env.example is committed).
#
# Values can also be set per client in the MCP config "env" block, which wins
# over this file.

# Where rendered PNGs are written when no outputPath is given.
DIAGRAM_MCP_OUTPUT_DIR=~/Documents/diagram-renders

# Pixel density multiplier for renders. 1 to 6, default 2.
# 2 is right for Confluence and most docs. 3 or 4 for print or large screens.
DIAGRAM_MCP_DEFAULT_SCALE=2

# Default page background: white or transparent.
DIAGRAM_MCP_BACKGROUND=white

# Margin around the diagram in pixels. 0 to 400.
DIAGRAM_MCP_PADDING=40

# Fallback font used when none of the families in the SVG are installed.
DIAGRAM_MCP_FONT_FAMILY=Helvetica

# Largest accepted diagram source, in characters.
DIAGRAM_MCP_MAX_CODE_CHARS=200000

# By default an explicit outputPath must sit inside the render directory or the
# working directory, so a caller cannot write over arbitrary files. Set to true
# only if you need renders written anywhere on disk.
DIAGRAM_MCP_ALLOW_ANY_OUTPUT_PATH=false
