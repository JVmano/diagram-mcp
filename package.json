{
  "name": "diagram-mcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server that turns diagram-as-code text into rendered PNG files, with no browser and no network.",
  "bin": {
    "diagram-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "npm install",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "check:sync": "node scripts/check-sync.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
